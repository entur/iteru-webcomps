# Committed overlay — keeps Input ⊆ Entity until sobek adds these to the read types.
# These fields are intentionally AHEAD of the live read schema.
#
# INVARIANT: this file is an input to `codegen.ts` ONLY. Every wire-facing
# generator (`scripts/generateDocuments.ts`, `codegen-operations.ts`) reads
# `sobek.schema.graphqls` alone, so nothing declared here can reach a request:
# it is absent from every selection set, and `reduceToSobekInput` strips it from
# the mutation input using the generated `<Entity>InputKeys` mask. Fields below
# render as ordinary editable controls and round-trip through `onChange`; only
# the wire edge drops them.

# Future fields agreed in entur/hathor#191 (entur/iteru-webcomps#50). Each is
# on BOTH the read type and the input, so distill derives it as editable — except
# `lifecycleStatus`, which sobek will derive (deactivate + validity): read type
# only, so it is serverManaged and renders as a permanently locked control.
enum AccessEquipment { KNEELING RAMP LIFT HOIST }
enum VehicleFacility { WIFI CLIMATE_CONTROL CCTV DEFIBRILLATOR }
enum TransponderType { AIS_CLASS_A AIS_CLASS_B OTHER }
enum LifecycleStatus { ACTIVE INACTIVE DESTROYED }
# Id-less list → no FIELDS entry; round-trips on Entity until a KV control (#9).
type KeyValue { key: String value: String }
input KeyValueInput { key: String value: String }
# NeTEx ValidBetween — a value object, so distill hoists fromDate / toDate.
type ValidBetween { fromDate: DateTime toDate: DateTime }
input ValidBetweenInput { fromDate: DateTime toDate: DateTime }

# NeTEx VehicleModel props inlined onto VehicleType (manufacturer, modelName,
# fullCharge). `range` is gone: sobek's `maximumRange` already carries it.
extend type VehicleType {
  manufacturer: String
  modelName: String
  fullCharge: Float                  # Wh (NeTEx FullCharge: WattHoursType)
  carLoading: Boolean
  draft: Float                       # m
  tareWeight: Float                  # kg
  minOperatingTemperature: Float     # °C
  maxOperatingTemperature: Float     # °C
  accessEquipment: [AccessEquipment]
  facilities: [VehicleFacility]      # sobek#114 `satisfiesFacilities`; rename when it lands
}
extend input VehicleTypeInput {
  manufacturer: String
  modelName: String
  fullCharge: Float
  carLoading: Boolean
  draft: Float
  tareWeight: Float
  minOperatingTemperature: Float
  maxOperatingTemperature: Float
  accessEquipment: [AccessEquipment]
  facilities: [VehicleFacility]
}
extend type Vehicle {
  completionDate: Date
  validBetween: ValidBetween         # no DecommissionDate on Vehicle in NeTEx 2.0
  callsign: String
  phoneNumber: String
  mmsi: String                       # ^\d{9}$ — validation is a follow-up
  transponderType: TransponderType
  transponderId: String
  contactRefs: [KeyValue]
  lifecycleStatus: LifecycleStatus   # read only → locked
}
extend input VehicleInput {
  completionDate: Date
  validBetween: ValidBetweenInput
  callsign: String
  phoneNumber: String
  mmsi: String
  transponderType: TransponderType
  transponderId: String
  contactRefs: [KeyValueInput]
}

# KV ("mockery") props from mural — not modelled yet. See entur/iteru-webcomps#9

# 3D geometry — inputs that drive @entur/iteru-3dbus geometry and have no NeTEx
# counterpart yet (entur/iteru-webcomps#51). Metres here; the 3D adapter converts
# to the bus input's mm. On both entities: a Vehicle value, when set, overrides
# its type's at render. `BusSection` carries an `id`, so distill makes
# `sections` a read-only `grid` (like `vehicles`); the id keys its rows.
# `windowCount` is 3dbus `windows_hint.count`: side windows on the entry side,
# door glass excluded; empty = the band is filled with panes of about the same
# width.
type BusSection {
  id: ID
  length: Float
  axles: [Float]
  bellowsAhead: Float
  windowCount: Int
}
input BusSectionInput {
  id: ID
  length: Float
  axles: [Float]
  bellowsAhead: Float
  windowCount: Int
}
extend type VehicleType {
  sections: [BusSection]
  tyreDiameter: Float
  baseColor: String
  roofEquipment: Float
}
extend input VehicleTypeInput {
  sections: [BusSectionInput]
  tyreDiameter: Float
  baseColor: String
  roofEquipment: Float
}
extend type Vehicle {
  sections: [BusSection]
  tyreDiameter: Float
  baseColor: String
  roofEquipment: Float
}
extend input VehicleInput {
  sections: [BusSectionInput]
  tyreDiameter: Float
  baseColor: String
  roofEquipment: Float
}
