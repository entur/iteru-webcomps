# Committed overlay — keeps Input ⊆ Entity until sobek adds these to the read types.
# These fields are intentionally AHEAD of the live read schema.
#
# INVARIANT: this file is an input to `codegen.ts` ONLY. Every wire-facing
# generator (`scripts/generateDocuments.ts`, `codegen-operations.ts`) reads
# `sobek.schema.graphqls` alone, so nothing declared here can reach a request:
# it is absent from every selection set, and `reduceToSobekInput` strips it from
# the mutation input using the generated `<Entity>InputKeys` mask. Fields below
# render as ordinary editable controls and round-trip through `onChange`; only
# the wire edge drops them.

# vehicleModel props inlined onto VehicleType (manufacturer / range / full-charge).
# Added to BOTH read + input so distill derives them as editable (not serverManaged).
extend type VehicleType {
  manufacturer: String
  range: Float
  fullCharge: Float
  carLoading: Boolean
}
extend input VehicleTypeInput {
  manufacturer: String
  range: Float
  fullCharge: Float
  carLoading: Boolean
}

# KV ("mockery") props from mural — not modelled yet. See entur/iteru-webcomps#9
